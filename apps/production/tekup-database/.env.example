# =====================================================
# Tekup Database - Environment Variables
# =====================================================
# This file is for LOCAL DEVELOPMENT ONLY
# Production uses Supabase - see .env.supabase.example
# =====================================================

# Node Environment
NODE_ENV=development

# =====================================================
# DATABASE CONNECTION - LOCAL DEVELOPMENT ONLY
# =====================================================

# Main database URL (Local development with Docker)
DATABASE_URL="postgresql://tekup:tekup123@localhost:5432/tekup_db"

# ⚠️ PRODUCTION DATABASE (Supabase - RECOMMENDED)
# For production, use the consolidated Supabase database:
# Copy .env.supabase.example to .env.production and configure
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.oaevagdgrasfppbrxbey.supabase.co:5432/postgres"

# Schema-specific URLs (For applications - LOCAL DEVELOPMENT)
DATABASE_URL_VAULT="postgresql://tekup:tekup123@localhost:5432/tekup_db?schema=vault"
DATABASE_URL_BILLY="postgresql://tekup:tekup123@localhost:5432/tekup_db?schema=billy"
DATABASE_URL_RENOS="postgresql://tekup:tekup123@localhost:5432/tekup_db?schema=renos"
DATABASE_URL_CRM="postgresql://tekup:tekup123@localhost:5432/tekup_db?schema=crm"
DATABASE_URL_FLOW="postgresql://tekup:tekup123@localhost:5432/tekup_db?schema=flow"
DATABASE_URL_SHARED="postgresql://tekup:tekup123@localhost:5432/tekup_db?schema=shared"

# For production, use Supabase URLs instead (see .env.supabase.example)

# Connection pooling (Production - anbefalet)
# DATABASE_URL_POOLED="postgresql://user:password@host/db?pgbouncer=true&connection_limit=10"

# =====================================================
# PRISMA CONFIGURATION
# =====================================================

# Prisma query engine (Production)
# PRISMA_QUERY_ENGINE_BINARY=/usr/bin/prisma-query-engine

# Enable query logging (Development only)
PRISMA_LOG_QUERIES=true

# =====================================================
# BACKUP & RESTORE
# =====================================================

# Backup storage path (Local)
BACKUP_PATH=./backups

# S3 Backup (Production - optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BACKUP_BUCKET=tekup-db-backups
# S3_BACKUP_REGION=eu-central-1

# =====================================================
# MONITORING & ALERTS
# =====================================================

# Sentry (Error tracking)
# SENTRY_DSN=

# Slack (Alerts)
# SLACK_WEBHOOK_URL=

# =====================================================
# MIGRATIONS
# =====================================================

# Auto-run migrations on startup (Production)
AUTO_MIGRATE=false

# Migration timeout (seconds)
MIGRATION_TIMEOUT=300
