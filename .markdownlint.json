{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint/v0.38.0/schema/markdownlint-config-schema.json",
  "default": true,
  "MD001": true,
  "MD003": false,
  "MD004": false,
  "MD007": false,
  "MD009": false,
  "MD010": {
    "code_blocks": true,
    "spaces_per_tab": 2
  },
  "MD012": false,
  "MD013": false,
  "MD022": false,
  "MD024": {
    "siblings_only": true
  },
  "MD025": false,
  "MD026": false,
  "MD029": false,
  "MD030": {
    "ul_single": 1,
    "ol_single": 1,
    "ul_multi": 1,
    "ol_multi": 1
  },
  "MD031": false,
  "MD032": false,
  "MD033": {
    "allowed_elements": [
      "details",
      "summary",
      "br",
      "img",
      "a",
      "kbd",
      "sub",
      "sup",
      "div",
      "span",
      "table",
      "tr",
      "td",
      "th",
      "thead",
      "tbody",
      "IconName",
      "Job"
    ]
  },
  "MD034": false,
  "MD035": {
    "style": "---"
  },
  "MD036": false,
  "MD037": false,
  "MD038": false,
  "MD040": false,
  "MD041": false,
  "MD046": false,
  "MD047": false,
  "MD049": false,
  "MD050": {
    "style": "asterisk"
  },
  "MD051": false,
  "MD052": {
    "shortcut_syntax": false
  },
  "MD053": {
    "ignored_definitions": ["//"]
  }
}
